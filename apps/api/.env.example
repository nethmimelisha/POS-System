DATABASE_URL="postgresql://pos:local-dev-password@localhost:5432/pos?schema=public"
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=12
MAX_CASHIER_DISCOUNT_PCT=10
SEED_ADMIN_USERNAME=admin
# Set this locally before running the dev seed. Never commit a real password.
SEED_ADMIN_PASSWORD=

# Optional local overrides
# TRUST_PROXY_HOPS=1
# ENFORCE_HTTPS=false
# JSON_BODY_LIMIT=256kb
# LOG_LEVEL=debug
# LOGIN_RATE_LIMIT_MAX=20
# SENSITIVE_RATE_LIMIT_MAX=60
# API_RATE_LIMIT_MAX=1200
# SEED_DEMO=1
# ENABLE_DEMO_USERS=true
# DEMO_PASSWORD=local-demo-password
