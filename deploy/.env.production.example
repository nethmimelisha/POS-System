# Copy to deploy/.env.production and replace every CHANGE_ME_* value.
# Run compose with: docker compose --env-file .\deploy\.env.production -f .\deploy\docker-compose.prod.yml ...

# Compose-level settings
POSTGRES_PASSWORD=CHANGE_ME_LONG_UNIQUE_DATABASE_PASSWORD
POS_DOMAIN=pos.example.lk
# Optional image tag override for upgrades and rollbacks.
IMAGE_TAG=latest

# API runtime
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://pos:CHANGE_ME_LONG_UNIQUE_DATABASE_PASSWORD@db:5432/pos?schema=public
# Bare HTTPS origins only, comma-separated, no path, no trailing slash, no localhost, no wildcard.
CORS_ORIGIN=https://pos.example.lk
SESSION_TTL_HOURS=12
MAX_CASHIER_DISCOUNT_PCT=10
# edge nginx -> web nginx -> api = 2 trusted proxy hops.
TRUST_PROXY_HOPS=2
# Leave unset or set to true in production. The API exits if this is false.
# ENFORCE_HTTPS=true
JSON_BODY_LIMIT=256kb
LOG_LEVEL=info
LOGIN_RATE_LIMIT_MAX=20
SENSITIVE_RATE_LIMIT_MAX=60
API_RATE_LIMIT_MAX=1200

# These must stay unset in production or the API exits at startup.
# SEED_DEMO=
# ENABLE_DEMO_USERS=
# DEMO_PASSWORD=
# SEED_ADMIN_PASSWORD=

# Backup scheduler and restore tooling
BACKUP_DIR=/backups
# MUST be stored separately from the backups themselves.
# PowerShell: $bytes = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Fill($bytes); [Convert]::ToBase64String($bytes)
# OpenSSL:    openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_KEEP=7
BACKUP_MAX_AGE_HOURS=26
BACKUP_HOUR=2
# Optional failure webhook for Slack, Teams, or a generic JSON endpoint receiving {text,...}.
ALERT_WEBHOOK_URL=
# Optional overrides if pg_dump / pg_restore are not on PATH in the container.
# PG_DUMP_PATH=/usr/bin/pg_dump
# PG_RESTORE_PATH=/usr/bin/pg_restore
